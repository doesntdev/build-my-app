# Local-only defaults; runtime must load the ignored local file explicitly.
APP_ENV=local
PORT=8080
APP_BASE_URL=http://127.0.0.1:8080
MAIL_MODE=capture
# This password is an intentional local fixture, never a production credential.
DATABASE_URL=postgresql://app_local:local-development-only@127.0.0.1:55432/app_local
# Container-to-container URL uses the database service name, not loopback.
# Provider keys belong in secure local/provider storage, not in this template.
